# Indexer settings. install.sh copies this file to indexer.env; fill in the IMAP part. No secret here: the mailbox
# password goes in secrets/imap_password (one line, mode 600).

# The mailbox to index (read only: the indexer only EXAMINEs folders and FETCHes with BODY.PEEK)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=mailbox@example.com

# The index the plugin searches
MEILI_INDEX=messages
# Languages of the mail, ISO 639-3, comma separated (eng, fra, deu, spa, ita…). Empty = let the engine guess.
INDEX_LOCALES=eng
# Folders never indexed, exact names as the webmail shows them, comma separated (e.g. Junk,Trash)
EXCLUDE_FOLDERS=
# Characters of body text kept per message (the rest is not searchable)
BODY_MAX_CHARS=20000

# Pace: messages fetched per batch, pause between batches (seconds), interval between incremental runs (seconds),
# and the daily reconciliation time (container time zone, TZ in .env)
BATCH_SIZE=1000
BATCH_PAUSE=0.5
INTERVAL_SECONDS=300
RECONCILE_AT=03:00
